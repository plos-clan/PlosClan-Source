---
import { getCollection } from 'astro:content'
import Comments from '../components/Comments.astro'
import Main from '../Main.astro'
import { PAGES } from '../site-config'
const resourceEntries = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order)
const categories = resourceEntries.reduce<
  Array<{
    description: string
    id: string
    name: string
    resources: typeof resourceEntries
  }>
>((list, resource) => {
  const existing = list.find((category) => category.id === resource.data.category)

  if (existing) {
    existing.resources.push(resource)
    return list
  }

  list.push({
    description: resource.data.categoryDescription,
    id: resource.data.category,
    name: resource.data.categoryName,
    resources: [resource]
  })

  return list
}, [])
---

<Main pageTitle={PAGES['/resources'].title}>
  <section class="bg-cyan-50 p-8 text-gray-700 dark:bg-cyan-900 dark:text-cyan-50">
    <h1 class="text-2xl font-bold">资源下载</h1>
    <p class="mt-2 text-cyan-700 dark:text-cyan-200">
      这里收集了各种与编程相关的资源，包括系统开发、语言实现等各个方面。
    </p>

    <div
      class="mt-6 flex flex-col space-y-4 sm:flex-row sm:items-center sm:space-x-4 sm:space-y-0"
      data-resources-page
    >
      <div class="grow z-10">
        <div class="relative inline-block w-full sm:max-w-96">
          <input
            class="w-full rounded-lg border border-cyan-200 bg-white px-4 py-2 pr-10 text-gray-700 shadow-sm focus:border-cyan-400 focus:outline-none dark:border-cyan-700 dark:bg-gray-800 dark:text-gray-200"
            data-resources-search
            placeholder="搜索资源..."
            type="text"
          />
          <button
            class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md px-2 py-1 text-gray-400 hover:text-cyan-600 dark:text-gray-500 dark:hover:text-cyan-300"
            data-resources-clear
            type="button"
          >
            🔍
          </button>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <button
          class="rounded-full bg-cyan-600 px-3 py-1 text-sm font-medium text-white transition-colors"
          data-resources-all
          type="button"
        >
          全部
        </button>

        {
          categories.map((category) => (
            <button
              class="rounded-full bg-gray-200 px-3 py-1 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600"
              data-resources-category={category.id}
              type="button"
            >
              {category.name}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <div class="mx-auto my-8 max-w-5xl px-4" data-resources-results>
    <div class="hidden rounded-lg bg-gray-100 p-8 text-center dark:bg-gray-800" data-resources-empty>
      <p class="text-lg text-gray-600 dark:text-gray-400">没有找到符合条件的资源</p>
    </div>

    {
      categories.map((category) => (
        <div class="mb-10" data-resources-section data-resources-section-id={category.id}>
          <h2 class="mb-2 text-xl font-bold text-gray-800 dark:text-gray-200">{category.name}</h2>
          <p class="mb-4 text-gray-600 dark:text-gray-400">{category.description}</p>

          <div class="grid gap-4 sm:grid-cols-1 md:grid-cols-2">
            {category.resources.map((resource) => (
              <div
                class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
                data-resources-card
                data-resources-search-text={`${resource.data.title} ${resource.data.description}`.toLowerCase()}
              >
                <div class="flex flex-col justify-between gap-4">
                  <div>
                    <h3 class="text-lg font-medium text-gray-800 dark:text-gray-200">
                      {resource.data.title}
                    </h3>
                    <p class="mt-1 text-gray-600 dark:text-gray-400">{resource.data.description}</p>
                  </div>

                  <div class="flex items-center justify-between">
                    <div class="text-sm text-gray-500 dark:text-gray-500">
                      <span>大小: {resource.data.fileSize}</span>
                      <span class="mx-2">•</span>
                      <span>日期: {resource.data.dateAdded}</span>
                    </div>

                    <a
                      class="rounded-lg bg-cyan-600 px-4 py-1.5 text-sm font-medium text-white transition-colors hover:bg-cyan-700 dark:bg-cyan-700 dark:hover:bg-cyan-600"
                      href={resource.data.downloadUrl}
                    >
                      下载
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <Comments />
</Main>

<script>
  const setupResourcesPage = () => {
    const root = document.querySelector<HTMLElement>('[data-resources-page]')

    if (!root || root.dataset.ready === 'true') {
      return
    }

    root.dataset.ready = 'true'

    const searchInput = root.querySelector<HTMLInputElement>('[data-resources-search]')
    const clearButton = root.querySelector<HTMLButtonElement>('[data-resources-clear]')
    const allButton = root.querySelector<HTMLButtonElement>('[data-resources-all]')
    const categoryButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-resources-category]'))
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-resources-section]')
    )
    const emptyState = document.querySelector<HTMLElement>('[data-resources-empty]')

    if (!searchInput || !clearButton || !allButton || !emptyState) {
      return
    }

    let activeCategory: string | null = null

    const activeClasses = ['bg-cyan-600', 'text-white']
    const inactiveClasses = [
      'bg-gray-200',
      'text-gray-700',
      'hover:bg-gray-300',
      'dark:bg-gray-700',
      'dark:text-gray-300',
      'dark:hover:bg-gray-600'
    ]

    const setButtonState = (button: HTMLButtonElement, isActive: boolean) => {
      activeClasses.forEach((className) => button.classList.toggle(className, isActive))
      inactiveClasses.forEach((className) => button.classList.toggle(className, !isActive))
    }

    const render = () => {
      const query = searchInput.value.trim().toLowerCase()
      let visibleSections = 0

      clearButton.textContent = query ? '✕' : '🔍'
      setButtonState(allButton, activeCategory === null)

      categoryButtons.forEach((button) => {
        setButtonState(button, button.dataset.resourcesCategory === activeCategory)
      })

      sections.forEach((section) => {
        const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-resources-card]'))
        const isCategoryMatch =
          activeCategory === null || section.dataset.resourcesSectionId === activeCategory
        let visibleCards = 0

        cards.forEach((card) => {
          const searchText = card.dataset.resourcesSearchText || ''
          const isVisible = isCategoryMatch && (query === '' || searchText.includes(query))

          card.classList.toggle('hidden', !isVisible)

          if (isVisible) {
            visibleCards += 1
          }
        })

        const shouldShowSection = isCategoryMatch && visibleCards > 0

        section.classList.toggle('hidden', !shouldShowSection)

        if (shouldShowSection) {
          visibleSections += 1
        }
      })

      emptyState.classList.toggle('hidden', visibleSections > 0)
    }

    searchInput.addEventListener('input', render)
    clearButton.addEventListener('click', () => {
      searchInput.value = ''
      render()
    })
    allButton.addEventListener('click', () => {
      activeCategory = null
      render()
    })
    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const categoryId = button.dataset.resourcesCategory

        activeCategory = activeCategory === categoryId ? null : categoryId || null
        render()
      })
    })

    render()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupResourcesPage, { once: true })
  } else {
    setupResourcesPage()
  }
</script>
