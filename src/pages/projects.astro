---
import { getCollection } from 'astro:content'
import Comments from '../components/Comments.astro'
import Main from '../Main.astro'
import { PAGES } from '../site-config'
const categories = [
  { id: 'all', name: '全部' },
  { id: 'kernel', name: '内核开发' },
  { id: 'language', name: '编程语言' },
  { id: 'vm', name: '虚拟机' }
]
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
---

<Main pageTitle={PAGES['/projects'].title}>
  <section class="bg-indigo-50 p-8 text-gray-700 dark:bg-indigo-900 dark:text-indigo-50">
    <h1 class="text-2xl font-bold">推荐项目</h1>
    <p class="mt-2 text-indigo-700 dark:text-indigo-200">
      我们创造了许多令人惊叹的低级软件项目，从操作系统内核到编程语言实现。
    </p>

    <div
      class="mt-6 flex flex-col space-y-4 sm:flex-row sm:items-center sm:space-x-4 sm:space-y-0"
      data-projects-page
    >
      <div class="grow z-10">
        <div class="relative inline-block w-full sm:max-w-96">
          <input
            class="w-full rounded-lg border border-indigo-200 bg-white px-4 py-2 pr-10 text-gray-700 shadow-sm focus:border-indigo-400 focus:outline-none dark:border-indigo-700 dark:bg-gray-800 dark:text-gray-200"
            data-projects-search
            placeholder="搜索项目..."
            type="text"
          />
          <button
            class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md px-2 py-1 text-gray-400 hover:text-indigo-600 dark:text-gray-500 dark:hover:text-indigo-300"
            data-projects-clear
            type="button"
          >
            🔍
          </button>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        {
          categories.map((category) => (
            <button
              class={`rounded-full px-3 py-1 text-sm font-medium transition-colors ${
                category.id === 'all'
                  ? 'bg-indigo-600 text-white'
                  : 'bg-gray-200 text-gray-700 hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600'
              }`}
              data-projects-category={category.id}
              type="button"
            >
              {category.name}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <div class="mx-auto my-8 max-w-5xl px-4">
    <div class="hidden rounded-lg bg-gray-100 p-8 text-center dark:bg-gray-800" data-projects-empty>
      <p class="text-lg text-gray-600 dark:text-gray-400">没有找到符合条件的项目</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-2" data-projects-list>
      {
        projects.map((project) => (
          <div
            class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-all hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
            data-projects-card
            data-projects-category-id={project.data.category}
            data-projects-search-text={`${project.data.title} ${project.data.description} ${project.data.technologies.join(' ')}`.toLowerCase()}
          >
            <img alt={project.data.title} class="h-48 w-full object-cover" src={project.data.image} />
            <div class="p-5">
              <h3 class="text-lg font-medium text-gray-800 dark:text-gray-200">{project.data.title}</h3>
              <p class="mt-2 text-gray-600 dark:text-gray-400">{project.data.description}</p>

              <div class="mt-4 flex flex-wrap gap-2">
                {
                  project.data.technologies.map((tech) => (
                    <span class="rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-medium text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">
                      {tech}
                    </span>
                  ))
                }
              </div>

              <div class="mt-4 flex items-center justify-between">
                <div class="text-sm text-gray-500 dark:text-gray-400">
                  作者: {project.data.creators.join(', ')}
                </div>

                <a
                  class="rounded-lg bg-indigo-600 px-4 py-1.5 text-sm font-medium text-white transition-colors hover:bg-indigo-700 dark:bg-indigo-700 dark:hover:bg-indigo-600"
                  href={project.data.github}
                >
                  查看项目
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 rounded-lg bg-linear-to-r from-indigo-500 to-purple-500 p-6 text-white shadow-md dark:from-indigo-600 dark:to-purple-700"
    >
      <h2 class="text-xl font-bold">有想要展示的项目？</h2>
      <p class="mt-2">你想把你的大作或答辩放上来吗？请自己到Github编辑这个页面。</p>
    </div>
  </div>

  <Comments />
</Main>

<script>
  const setupProjectsPage = () => {
    const root = document.querySelector<HTMLElement>('[data-projects-page]')

    if (!root || root.dataset.ready === 'true') {
      return
    }

    root.dataset.ready = 'true'

    const searchInput = root.querySelector<HTMLInputElement>('[data-projects-search]')
    const clearButton = root.querySelector<HTMLButtonElement>('[data-projects-clear]')
    const categoryButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-projects-category]'))
    const list = document.querySelector<HTMLElement>('[data-projects-list]')
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-projects-card]'))
    const emptyState = document.querySelector<HTMLElement>('[data-projects-empty]')

    if (!searchInput || !clearButton || !list || !emptyState) {
      return
    }

    let activeCategory = 'all'

    const activeClasses = ['bg-indigo-600', 'text-white']
    const inactiveClasses = [
      'bg-gray-200',
      'text-gray-700',
      'hover:bg-gray-300',
      'dark:bg-gray-700',
      'dark:text-gray-300',
      'dark:hover:bg-gray-600'
    ]

    const setButtonState = (button: HTMLButtonElement, isActive: boolean) => {
      activeClasses.forEach((className) => button.classList.toggle(className, isActive))
      inactiveClasses.forEach((className) => button.classList.toggle(className, !isActive))
    }

    const render = () => {
      const query = searchInput.value.trim().toLowerCase()
      const visibleCards = cards.filter((card) => {
        const matchesCategory =
          activeCategory === 'all' || card.dataset.projectsCategoryId === activeCategory
        const searchText = card.dataset.projectsSearchText || ''
        const matchesSearch = query === '' || searchText.includes(query)

        return matchesCategory && matchesSearch
      })

      clearButton.textContent = query ? '✕' : '🔍'

      categoryButtons.forEach((button) => {
        setButtonState(button, button.dataset.projectsCategory === activeCategory)
      })

      cards.forEach((card) => card.classList.add('hidden'))
      visibleCards.forEach((card) => {
        card.classList.remove('hidden')
        list.append(card)
      })

      const hasResults = visibleCards.length > 0

      list.classList.toggle('hidden', !hasResults)
      emptyState.classList.toggle('hidden', hasResults)
    }

    searchInput.addEventListener('input', render)
    clearButton.addEventListener('click', () => {
      searchInput.value = ''
      render()
    })
    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.projectsCategory || 'all'
        render()
      })
    })

    render()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectsPage, { once: true })
  } else {
    setupProjectsPage()
  }
</script>
